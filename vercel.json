{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "revelationagency.com"
        }
      ],
      "destination": "https://www.revelationagency.com/:path*",
      "permanent": true
    },
    {
      "source": "/services/creative/branding",
      "destination": "/services/branding/brand-strategy-identity",
      "permanent": true
    },
    {
      "source": "/services/creative/website-development",
      "destination": "/services/branding/websites-landing-pages",
      "permanent": true
    },
    {
      "source": "/services/creative/app-development",
      "destination": "/services/branding/apps-digital-products",
      "permanent": true
    },
    {
      "source": "/services/creative/video-production",
      "destination": "/services/branding/video-visual-content",
      "permanent": true
    },
    {
      "source": "/services/creative",
      "destination": "/services/branding",
      "permanent": true
    },
    {
      "source": "/services/marketing/search-rankings",
      "destination": "/services/marketing/seo-ai-visibility",
      "permanent": true
    },
    {
      "source": "/services/marketing/outsource-marketing",
      "destination": "/services/marketing",
      "permanent": true
    },
    {
      "source": "/services/systems/sales-infrastructure",
      "destination": "/services/sales/crm-sales-infrastructure",
      "permanent": true
    },
    {
      "source": "/services/systems/brand-systems",
      "destination": "/services/branding/brand-strategy-identity",
      "permanent": true
    },
    {
      "source": "/services/systems/digital-presence",
      "destination": "/services/branding/websites-landing-pages",
      "permanent": true
    },
    {
      "source": "/services/systems/ai-automation",
      "destination": "/services/sales/ai-automation-systems",
      "permanent": true
    },
    {
      "source": "/services/systems",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/portfolio/creative",
      "destination": "/portfolio/branding",
      "permanent": true
    },
    {
      "source": "/portfolio/systems",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio/creative/branding",
      "destination": "/portfolio?filter=b3",
      "permanent": true
    },
    {
      "source": "/portfolio/creative/website-development",
      "destination": "/portfolio?filter=b1",
      "permanent": true
    },
    {
      "source": "/portfolio/creative/app-development",
      "destination": "/portfolio?filter=b2",
      "permanent": true
    },
    {
      "source": "/portfolio/creative/video-production",
      "destination": "/portfolio?filter=b5",
      "permanent": true
    },
    {
      "source": "/portfolio/systems/brand-systems",
      "destination": "/portfolio?filter=b3",
      "permanent": true
    },
    {
      "source": "/portfolio/systems/digital-presence",
      "destination": "/portfolio?filter=b1",
      "permanent": true
    },
    {
      "source": "/portfolio/systems/sales-infrastructure",
      "destination": "/portfolio?filter=s3",
      "permanent": true
    },
    {
      "source": "/portfolio/systems/ai-automation",
      "destination": "/portfolio?filter=s4",
      "permanent": true
    },
    {
      "source": "/portfolio/marketing/search-rankings",
      "destination": "/portfolio?filter=m1",
      "permanent": true
    },
    {
      "source": "/portfolio/marketing/social-media",
      "destination": "/portfolio?filter=m2",
      "permanent": true
    },
    {
      "source": "/portfolio/marketing/outsource-marketing",
      "destination": "/portfolio?filter=marketing",
      "permanent": true
    },
    {
      "source": "/portfolio/marketing/digital-ads",
      "destination": "/portfolio?filter=m3",
      "permanent": true
    },
    {
      "source": "/services/marketing/positioning-content-authority",
      "destination": "/services/marketing/seo-ai-visibility",
      "permanent": true
    },
    {
      "source": "/services/sales/follow-up-nurture",
      "destination": "/services/marketing/email-lifecycle-marketing",
      "permanent": true
    },
    {
      "source": "/services/sales/conversion-advertising",
      "destination": "/services/marketing/digital-ads",
      "permanent": true
    },
    {
      "source": "/services/ai-automation",
      "destination": "/services/sales/ai-automation-systems",
      "permanent": true
    },
    {
      "source": "/services/strategy/brand-strategy",
      "destination": "/services/branding/brand-strategy-identity",
      "permanent": true
    },
    {
      "source": "/services/strategy",
      "destination": "/services/branding",
      "permanent": true
    },
    {
      "source": "/services/strategy/:path*",
      "destination": "/services/branding",
      "permanent": true
    },
    {
      "source": "/portfolio/strategy/brand-strategy",
      "destination": "/portfolio/branding?filter=branding",
      "permanent": true
    },
    {
      "source": "/portfolio/strategy",
      "destination": "/portfolio/branding",
      "permanent": true
    },
    {
      "source": "/portfolio/strategy/:path*",
      "destination": "/portfolio/branding?filter=branding",
      "permanent": true
    },
    {
      "source": "/services/systems/brand-strategy",
      "destination": "/services/branding/brand-strategy-identity",
      "permanent": true
    },
    {
      "source": "/portfolio/systems/brand-strategy",
      "destination": "/portfolio/branding?filter=branding",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/g/bill",
      "destination": "/sales-growth-engine?ref=bill-gerard"
    },
    {
      "source": "/partners/bill",
      "destination": "/sales-growth-engine?ref=bill-gerard"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "^(www\\.)?revelationagency\\.com$"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
